{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hades-agent.invalid/schemas/agent-result.json",
  "title": "Hades Agent run result",
  "type": "object",
  "required": ["schema_version", "outcome", "task_id", "summary", "evidence"],
  "properties": {
    "schema_version": {"const": 1},
    "outcome": {"enum": ["complete", "blocked", "cancelled"]},
    "task_id": {"type": "string", "pattern": "^HAD-[0-9]{3,}$"},
    "summary": {"type": "string", "minLength": 1},
    "changed_paths": {"type": "array", "items": {"type": "string"}},
    "commands": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "blocker": {"type": "string"},
    "next_action": {"type": "string"}
  },
  "additionalProperties": false
}
